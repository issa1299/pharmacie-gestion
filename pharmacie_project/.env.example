# Copier ce fichier en .env pour le développement local :
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# Sécurité
DEBUG=True
SECRET_KEY=remplacez-moi-par-une-cle-longue-et-aleatoire

# Base de données : laisser vide en local (SQLite).
# En production (Render), DATABASE_URL est injectée automatiquement.
DATABASE_URL=

# PythonAnywhere : votre domaine (ex : monutilisateur.pythonanywhere.com)
PYTHONANYWHERE_HOST=

# HTTPS (optionnel — garder à False sur PythonAnywhere par défaut)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email (facultatif — sinon les emails s'affichent dans la console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# SMS Twilio (facultatif)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
